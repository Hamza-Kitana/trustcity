# انسخ إلى `.env` أو `.env.local` للتطوير المحلي — لا ترفع الأسرار إلى git
#
# على Vercel: القيم في `.env.production` تُستخدم تلقائياً عند البناء.
# يمكنك أيضاً تعيين نفس المفاتيح في Vercel → Settings → Environment Variables ثم Redeploy.

# رابط انضمام سيرفر الديسكورد
VITE_DISCORD_INVITE_URL=https://discord.gg/INFCFW

# تسجيل دخول المستخدم العام عبر Discord (OAuth2 + PKCE)
# https://discord.com/developers/applications → OAuth2 → Redirects
# التطوير:  http://localhost:8080/auth/discord/callback
# الإنتاج:  https://trustcity.vercel.app/auth/discord/callback
VITE_DISCORD_CLIENT_ID=1508945659447869630

# اختياري — إن تُركت فارغة: origin الحالي + /auth/discord/callback
# VITE_DISCORD_REDIRECT_URI=
