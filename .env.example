# انسخ إلى `.env` أو `.env.local` للتطوير المحلي — لا ترفع الأسرار إلى git
#
# على Vercel: Project → Settings → Environment Variables
#   أضف نفس المفاتيح (Production + Preview) ثم Redeploy — التغيير لا يظهر بدون إعادة نشر.

# رابط انضمام سيرفر الديسكورد (يظهر في التواصل، التقديم، الفوتر، إلخ)
VITE_DISCORD_INVITE_URL=https://discord.gg/INFCFW

# تسجيل دخول المستخدم العام عبر Discord (OAuth2 + PKCE)
# أنشئ تطبيقاً من https://discord.com/developers/applications
# في OAuth2 → Redirects أضف نفس الرابط بالضبط، مثال التطوير:
#   http://localhost:8080/auth/discord/callback
# والإنتاج (TRUST CFW على Vercel):
#   https://trustcity.vercel.app/auth/discord/callback
VITE_DISCORD_CLIENT_ID=1508945659447869630

# اختياري — إذا تركتها فارغة يُستخدم تلقائياً:
#   window.location.origin + "/auth/discord/callback"
# VITE_DISCORD_REDIRECT_URI=
